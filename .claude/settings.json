{
  "agent": "po",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh auth status:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/task-status.ps1:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backlog-validate.ps1:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docs-links.ps1:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/task-verify.ps1:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",

      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.angular/**)",
      "Read(./**/TestResults/**)",
      "Read(./**/test-results/**)",
      "Read(./**/playwright-report/**)",
      "Read(./**/blob-report/**)",
      "Read(./**/coverage/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Read(./**/*.zip)",
      "Read(./**/*.nupkg)",
      "Read(./**/*.dll)",
      "Read(./**/*.pdb)",
      "Read(./**/*.woff2)",
      "Read(./**/package-lock.json)",

      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/appsettings.*.local.json)"
    ]
  }
}
