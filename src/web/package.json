{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:selftest": "node scripts/check-selftest.mjs",
    "check": "npm run check:versions && npm run check:licenses && npm run check:selftest",
    "test": "npm run check && ng test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "1.63.0",
    "fflate": "0.8.3",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vitest": "4.1.11"
  }
}
