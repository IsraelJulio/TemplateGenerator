/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "include": ["src/**/*.ts"],
  // `src/app/testing/` é apoio de teste: fixtures e a declaração de `node:fs`,
  // que é ambiente e faria o código de produção typecheckar um `readFileSync`
  // impossível no navegador. Fora do programa da aplicação, portanto.
  "exclude": ["src/**/*.spec.ts", "src/app/testing/**"]
}
