<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>__TargetFramework__</TargetFramework>
    <RootNamespace>__ProjectName__.Api</RootNamespace>
    <AssemblyName>__ProjectName__.Api</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    A composição: é aqui, e só aqui, que `Application` e `Infrastructure` se encontram. `Domain`
    chega por transitividade e não é referenciado de novo — declarar a mesma aresta duas vezes não
    acrescenta garantia nenhuma e esconde qual é o caminho de verdade.
  -->
  <ItemGroup>
    <ProjectReference Include="..\__ProjectName__.Application\__ProjectName__.Application.csproj" />
    <ProjectReference Include="..\__ProjectName__.Infrastructure\__ProjectName__.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Este projeto declara exatamente as dependências da combinação escolhida, cada uma com versão
    exata (RNF-06), em um grupo por assunto. Uma opção que você não marcou não deixa dependência
    para trás — e uma combinação que não precisa de pacote algum não ganha nem um grupo vazio
    (RF-20).
  -->
__ApiPackageReferences__

</Project>
